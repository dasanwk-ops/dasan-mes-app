// EMULATOR TEST FIXTURE ONLY. DO NOT DEPLOY TO A REAL PROJECT.
// This is NOT a production authorization policy.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /artifacts/{app}/public/data/{col}/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && col != 'denied';
    }
    match /print-queue/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
